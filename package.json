{
  "name": "uk-neighbour",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "vite build",
    "preview": "node --use-env-proxy node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node --test",
    "start": "node --use-env-proxy server/start.js",
    "cf:dev": "npm run build && wrangler dev --ip 127.0.0.1",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.3.0",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
