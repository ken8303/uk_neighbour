{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uk-neighbour",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
